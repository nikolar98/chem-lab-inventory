<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ChemicalCostReport" pageWidth="700" pageHeight="842" columnWidth="660" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="ddad4b30-c694-4c71-9bce-02a25619a37f">
	<parameter name="fromDate" class="java.util.Date"/>
	<parameter name="toDate" class="java.util.Date"/>
	<parameter name="chemicalIds" class="java.util.List"/>
	<parameter name="includePotrosnja" class="java.lang.Boolean"/>
	<parameter name="includeStanje" class="java.lang.Boolean"/>
	<parameter name="includeCena" class="java.lang.Boolean"/>
	<queryString>
		<![CDATA[SELECT
    c.name AS HEMIKALIJA,
    CASE
        WHEN LOWER(cb.package_unit) = 'l' THEN 'L'
        ELSE cb.package_unit
    END AS JEDINICA,
    SUM(cb.current_quantity) AS TRENUTNO_STANJE,
    SUM(cb.package_price * cb.current_quantity) AS UKUPNA_CENA,
    COALESCE((
        SELECT SUM(cons.quantity)
        FROM consumptions cons
        JOIN chemical_batches sub_cb ON sub_cb.id = cons.chemical_batch_id
        WHERE sub_cb.chemical_id = c.id
          AND cons.date_taken BETWEEN $P{fromDate} AND $P{toDate}
    ), 0) AS POTROSENO_U_PERIODU
FROM chemical_batches cb
JOIN chemicals c ON c.id = cb.chemical_id
WHERE $X{IN, c.id, chemicalIds}
GROUP BY c.id, c.name, cb.package_unit
ORDER BY c.name ASC]]>
	</queryString>
	<field name="HEMIKALIJA" class="java.lang.String"/>
	<field name="JEDINICA" class="java.lang.String"/>
	<field name="TRENUTNO_STANJE" class="java.math.BigDecimal"/>
	<field name="UKUPNA_CENA" class="java.math.BigDecimal"/>
	<field name="POTROSENO_U_PERIODU" class="java.math.BigDecimal"/>
