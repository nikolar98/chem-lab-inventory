<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                                  http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="ChemicalCostReport" pageWidth="595" pageHeight="842"
              columnWidth="555" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20">

    <queryString>
        <![CDATA[
        SELECT
            c.name AS HEMIKALIJA,
            CASE
                WHEN LOWER(cb.package_unit) = 'l' THEN 'L'
                ELSE cb.package_unit
            END AS JEDINICA,
            SUM(cb.current_quantity) AS UKUPNA_KOLICINA,
            SUM(cb.total_price) AS UKUPNA_CENA
        FROM chemical_batches cb
        JOIN chemicals c ON c.id = cb.chemical_id
        GROUP BY c.name, cb.package_unit
        ORDER BY UKUPNA_CENA DESC
        ]]>
    </queryString>

    <field name="HEMIKALIJA" class="java.lang.String"/>
    <field name="JEDINICA" class="java.lang.String"/>
    <field name="UKUPNA_KOLICINA" class="java.math.BigDecimal"/>
    <field name="UKUPNA_CENA" class="java.math.BigDecimal"/>

    <title>
        <band height="80">
            <staticText>
                <reportElement x="0" y="10" width="555" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[Izveštaj o ukupnoj ceni po hemikaliji]]></text>
            </staticText>

            <line>
                <reportElement x="0" y="45" width="555" height="1"/>
                <graphicElement>
                    <pen lineWidth="0.8" lineColor="#333333"/>
                </graphicElement>
            </line>
        </band>
    </title>

    <columnHeader>
        <band height="28">
            <staticText>
                <reportElement x="0" y="0" width="230" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="14" isBold="true"/>
                </textElement>
                <text>Hemikalija</text>
            </staticText>

            <staticText>
                <reportElement x="230" y="0" width="150" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="14" isBold="true"/>
                </textElement>
                <text>Ukupna količina</text>
            </staticText>

            <staticText>
                <reportElement x="380" y="0" width="175" height="25"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="14" isBold="true"/>
                </textElement>
                <text>Ukupna cena (RSD)</text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="24">
            <textField>
                <reportElement x="0" y="0" width="230" height="22"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="11"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{HEMIKALIJA}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="230" y="0" width="150" height="22"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="11"/>
                </textElement>
                <textFieldExpression><![CDATA[
String.format("%.1f %s",
    $F{UKUPNA_KOLICINA}.doubleValue(),
    $F{JEDINICA})
]]></textFieldExpression>
            </textField>

            <textField pattern="#,##0.00">
                <reportElement x="380" y="0" width="175" height="22"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="11"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{UKUPNA_CENA}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="25">
            <textField>
                <reportElement x="400" y="0" width="155" height="20"/>
                <textElement textAlignment="Right">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Strana " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

</jasperReport>